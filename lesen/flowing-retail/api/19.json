{"datei":"kafka/java/checkout/src/main/java/io/flowing/retail/checkout/rest/ShopRestController.java","start":20,"zeile":24,"zeilen":["  @Autowired","  private MessageSender messageSender;","  ","  @RequestMapping(path = \"/api/cart/order\", method = PUT)","  public String placeOrder(@RequestParam(value = \"customerId\") String customerId) {","    ","    Order order = new Order();","    order.addItem(\"article1\", 5);","    order.addItem(\"article2\", 10);","    ","    order.setCustomer(new Customer(\"Camunda\", \"Zossener Strasse 55\\n10961 Berlin\\nGermany\"));","    ","    Message<Order> message = new Message<Order>(\"OrderPlacedEvent\", order);","    messageSender.send(message);","        ","    // note that we cannot easily return an order id here - as everything is asynchronous","    // and blocking the client is not what we want.","    // but we return an own correlationId which can be used in the UI to show status maybe later","    return \"{\\\"traceId\\\": \\\"\" + message.getTraceid() + \"\\\"}\";"],"gesamt":41}