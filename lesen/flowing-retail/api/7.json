},"K19":{"anforderungen":["A-5.3-2"],"regeln":[],"code":[],"bpmn":[{"modell":"v:kafka/java/payment-zeebe/src/main/resources/payment.bpmn","element":"Task_1yuae6d"}]},"K20":{"anforderungen":["A-4.6-4","A-4.2-2","A-4.3-3","A-4.6-1"],"regeln":[],"code":[],"bpmn":[]},"K21":{"anforderungen":["A-5.3-1","A-5.3-2","A-5.3-3","A-5.3-4"],"regeln":[],"code":[],"bpmn":[{"modell":"v:kafka/java/payment-zeebe/src/main/resources/payment.bpmn","element":"Task_0sdkq4x"}]},"K22":{"anforderungen":["A-5.1-1","A-5.1-2","A-5.1-3","A-5.1-4"],"regeln":[],"code":[],"bpmn":[{"modell":"v:kafka/java/payment-zeebe/src/main/resources/payment.bpmn","element":"Task_0e2306u"}]},"K23":{"anforderungen":["A-5.1-2","A-5.1-4","A-5.2-1"],"regeln":["R-6"],"code":[{"klasse":"ChargeCreditCardAdapter","methode":"chargeCreditCard","dienst":"payment","paket":"io.flowing.retail.payment.flow"}],"bpmn":[]}},"anforderungen":[{"id":"A-4.1-1","text":"Der Kunde kann eine Bestellung mit mindestens einer Bestellposition aufgeben.","anzahl":0},{"id":"A-4.1-2","text":"Bei Aufgabe der Bestellung wird eine eindeutige Bestellnummer und eine Vorgangsnummer vergeben.","anzahl":1},{"id":"A-4.1-3","text":"Der Shop meldet die Bestellung mit Kunde, Lieferadresse und Bestellpositionen als Ereignis „Bestellung aufgegeben“ (OrderPlacedEvent).","anzahl":1},{"id":"A-4.1-4","text":"Die Auftragsabwicklung speichert die Bestellung und startet für sie den Hauptprozess.","anzahl":0},{"id":"A-4.1-5","text":"Der Shop gibt dem Kunden die Vorgangsnummer zurück, damit er den Stand verfolgen kann.","anzahl":0},{"id":"A-4.2-1","text":"Vor dem Einziehen der Zahlung reserviert das Lager den Bestand für alle Bestellpositionen.","anzahl":2},{"id":"A-4.2-2","text":"Ist für eine Bestellposition nicht genug Bestand vorhanden, wird die Bestellung storniert und der Kunde benachrichtigt (Kapitel 4.6).","anzahl":2},{"id":"A-4.2-3","text":"Eine Reservierung läuft nach 7 Tagen ab, wenn die Bestellung bis dahin nicht kommissioniert wurde.","anzahl":1},{"id":"A-4.3-1","text":"Die Auftragsabwicklung fordert bei der Zahlung den Bestellwert an (Kommando „Zahlung einziehen“, RetrievePaymentCommand) mit Bestellnummer als Bezug, Grund „order“ und Betrag.","anzahl":1},{"id":"A-4.3-2","text":"Die Auftragsabwicklung wartet auf das Ereignis „Zahlung eingegangen“ (PaymentReceivedEvent) mit derselben Korrelationsnummer.","anzahl":1},{"id":"A-4.3-3","text":"Meldet die Zahlung „Zahlung gescheitert“ (PaymentFailedEvent), wird die Bestellung storniert (Kapitel 4.6).","anzahl":2},{"id":"A-4.3-4","text":"Kommt innerhalb von 8 Tagen weder „Zahlung eingegangen“ noch „Zahlung gescheitert“, wird der Vorgang einem Sachbearbeiter zur Klärung vorgelegt.","anzahl":2},{"id":"A-4.4-1","text":"Erst nach Zahlungseingang beauftragt die Auftragsabwicklung das Lager, die Waren zu kommissionieren (Kommando FetchGoodsCommand mit den Bestellpositionen).","anzahl":1},{"id":"A-4.4-2","text":"Das Lager erstellt einen Kommissionierauftrag, entnimmt die reservierten Artikel und meldet „Waren kommissioniert“ (GoodsFetchedEvent) mit der Kommissioniernummer.","anzahl":0},{"id":"A-4.5-1","text":"Nach der Kommissionierung beauftragt die Auftragsabwicklung den Versand (Kommando ShipGoodsCommand) mit Kommissioniernummer, Name und Lieferadresse des Empfängers und dem Logistikdienstleister.","anzahl":2},{"id":"A-4.5-2","text":"Der Versand erstellt die Sendung, übergibt sie dem Logistikdienstleister und meldet „Waren versandt“ (GoodsShippedEvent) mit der Sendungsnummer.","anzahl":1},{"id":"A-4.5-3","text":"Danach meldet die Auftragsabwicklung „Bestellung abgeschlossen“ (OrderCompletedEvent) und beendet den Hauptprozess.","anzahl":1},{"id":"A-4.6-1","text":"Wird eine Bestellung storniert, gibt das Lager alle Reservierungen der Bestellung frei.","anzahl":2},{"id":"A-4.6-2","text":"Wurde bereits ein Betrag eingezogen, wird er dem Kundenguthaben gutgeschrieben.","anzahl":1},{"id":"A-4.6-3","text":"Der Kunde wird über die Stornierung mit Grund benachrichtigt.","anzahl":1},{"id":"A-4.6-4","text":"Die Auftragsabwicklung meldet „Bestellung storniert“ (OrderCancelledEvent).","anzahl":2},{"id":"A-5.1-1","text":"Zuerst wird ein vorhandenes Kundenguthaben mit dem angeforderten Betrag verrechnet; das Guthaben verringert sich um den verrechneten Betrag.","anzahl":1},{"id":"A-5.1-2","text":"Der Restbetrag ist der angeforderte Betrag abzüglich des verrechneten Guthabens.","anzahl":2},{"id":"A-5.1-3","text":"Die Zahlung meldet „Kundenguthaben verrechnet“ (CustomerCreditUsed), wenn Guthaben verrechnet wurde.","anzahl":2},{"id":"A-5.1-4","text":"Ist der Restbetrag 0, ist die Zahlung vollständig; weiter mit Kapitel 5.4.","anzahl":2},{"id":"A-5.2-1","text":"Ist der Restbetrag größer als 0, wird die Kreditkarte des Kunden über den Zahlungsdienstleister mit dem Restbetrag belastet.","anzahl":2},{"id":"A-5.2-2","text":"Bei Erfolg wird die Transaktionsnummer gespeichert und „Kreditkarte belastet“ (CreditCardCharged) gemeldet.","anzahl":3},{"id":"A-5.2-3","text":"Lehnt der Zahlungsdienstleister die Belastung ab, geht es mit Kapitel 5.3 weiter.","anzahl":1},{"id":"A-5.3-1","text":"Der Kunde wird aufgefordert, seine Kreditkartendaten zu aktualisieren (E-Mail mit Link).","anzahl":1},{"id":"A-5.3-2","text":"Aktualisiert der Kunde die Daten (Nachricht „Kreditkarte aktualisiert“), wird die Belastung wiederholt (Kapitel 5.2).","anzahl":2},{"id":"A-5.3-3","text":"Aktualisiert der Kunde die Daten nicht innerhalb von 7 Tagen, ist die Zahlung gescheitert; die Zahlung meldet „Zahlung gescheitert“ (PaymentFailedEvent) mit Grund und gutgeschriebenes Guthaben wird zurückgebucht.","anzahl":2},{"id":"A-5.3-4","text":"Die Belastung wird höchstens dreimal wiederholt; danach ist die Zahlung gescheitert.","anzahl":3},{"id":"A-5.4-1","text":"Ist der Betrag vollständig eingezogen, meldet die Zahlung „Zahlung eingegangen“ (PaymentReceivedEvent) mit Bezug (Bestellnummer) und der Korrelationsnummer der Anforderung.","anzahl":2},{"id":"A-7-1","text":"Ein Dienst verarbeitet dieselbe Nachricht (gleiche Nachrichtennummer) nur einmal.","anzahl":1},{"id":"A-7-2","text":"Die Überwachung zeigt alle Nachrichten einer Vorgangsnummer in zeitlicher Folge an.","anzahl":0},{"id":"A-8-1","text":"Jeder Dienst speichert nur die Daten seiner eigenen Aggregate; andere Dienste werden über den Bezug (Bestellnummer) angesprochen.","anzahl":1},{"id":"A-8-2","text":"Die Status einer Bestellung folgen der Reihenfolge aufgegeben → bezahlt → kommissioniert → versandt → abgeschlossen; storniert ist aus jedem Status außer versandt und abgeschlossen erreichbar.","anzahl":1},{"id":"A-9-1","text":"Fällt ein Dienst vorübergehend aus, gehen keine Nachrichten verloren; sie werden nach dem Wiederanlauf verarbeitet.","anzahl":0},{"id":"A-9-2","text":"Der Stand jeder Bestellung ist jederzeit über die Vorgangsnummer nachvollziehbar.","anzahl":0},{"id":"A-9-3","text":"Prozessmodelle werden von dem Dienst bereitgestellt, der den Prozess verantwortet (Auftragsabwicklung den Hauptprozess, Zahlung den Teilprozess Zahlung).","anzahl":0},{"id":"REQ-T-4.1-A1-01","text":"Die Kundenoberfläche muss Kunde die Möglichkeit bieten, eine Bestellung mit mindestens einer Bestellposition aufzugeben.","anzahl":0},{"id":"REQ-T-4.1-A6-01","text":"Die Kundenoberfläche muss fähig sein, die Vorgangsnummer von Shop entgegenzunehmen.","anzahl":0},{"id":"REQ-T-4.2-A3-01","text":"Die Kundenoberfläche muss fähig sein, die Benachrichtigung über die Stornierung der Bestellung von Lager entgegenzunehmen.","anzahl":0},{"id":"REQ-T-4.6-A3-01","text":"Die Kundenoberfläche muss fähig sein, die Mitteilung über die Stornierung mit Grund von Auftragsabwicklung entgegenzunehmen.","anzahl":0},{"id":"REQ-T-5.3-A1-01","text":"Die Kundenoberfläche muss Kunde die Möglichkeit bieten, seine Kreditkartendaten zu aktualisieren.","anzahl":0},{"id":"REQ-T-5.3-A1-02","text":"Die Kundenoberfläche muss fähig sein, an die Zahlung zu übermitteln.","anzahl":0},{"id":"REQ-Z-4.1-A2-01","text":"Shop muss eine eindeutige Bestellnummer vergeben.","anzahl":0},{"id":"REQ-Z-4.1-A2-02","text":"Shop muss eine Vorgangsnummer vergeben.","anzahl":0},{"id":"REQ-Z-4.1-A3-01","text":"Shop muss fähig sein, die Bestellung mit Kunde, Lieferadresse und Bestellpositionen als Ereignis „Bestellung aufgegeben“ zu melden.","anzahl":0},{"id":"REQ-Z-4.1-A6-01","text":"Shop muss fähig sein, dem Kunden die Vorgangsnummer zurückzugeben.","anzahl":0},{"id":"REQ-Z-4.2-A1-01","text":"Shop muss Lager die Möglichkeit bieten, den Bestand für alle Bestellpositionen zu reservieren.","anzahl":0},{"id":"REQ-Z-4.2-A2-01","text":"Wenn für eine Bestellposition nicht genug Bestand vorhanden ist, muss Shop Lager die Möglichkeit bieten, die Bestellung zu stornieren.","anzahl":0},{"id":"REQ-Z-4.2-A3-01","text":"Wenn für eine Bestellposition nicht genug Bestand vorhanden ist, muss Shop fähig sein, den Kunden über die Stornierung der Bestellung zu benachrichtigen.","anzahl":0},{"id":"REQ-Z-4.3-A1-01","text":"Shop muss fähig sein, den Bestellwert bei der Zahlung anzufordern.","anzahl":0},{"id":"REQ-Z-4.3-A2-01","text":"Shop muss fähig sein, auf das Ereignis „Zahlung eingegangen“ mit derselben Korrelationsnummer zu warten.","anzahl":0},{"id":"REQ-Z-4.3-A3-01","text":"Wenn die Zahlung „Zahlung gescheitert“ meldet, muss Shop die Bestellung stornieren.","anzahl":0},{"id":"REQ-Z-4.3-A4-01","text":"Wenn innerhalb von 8 Tagen weder „Zahlung eingegangen“ noch „Zahlung gescheitert“ eintrifft, muss Shop fähig sein, den Vorgang einem Sachbearbeiter zur Klärung vorzulegen.","anzahl":0},{"id":"REQ-Z-4.5-A1-01","text":"Shop muss fähig sein, den Versand zu beauftragen.","anzahl":0},{"id":"REQ-Z-4.5-A2-01","text":"Shop muss die Sendung erstellen.","anzahl":0},{"id":"REQ-Z-4.5-A3-01","text":"Shop muss fähig sein, dem Logistikdienstleister zu übergeben.","anzahl":0},{"id":"REQ-Z-4.5-A4-01","text":"Shop muss fähig sein, den Abschluss der Bestellung zu melden.","anzahl":0},{"id":"REQ-Z-4.5-A4-02","text":"Shop muss den Hauptprozess beenden.","anzahl":0},{"id":"REQ-Z-4.6-A1-01","text":"Shop muss Lager die Möglichkeit bieten, alle Reservierungen der Bestellung freizugeben.","anzahl":0},{"id":"REQ-Z-4.6-A2-01","text":"Wenn bereits ein Betrag eingezogen wurde, muss Shop Auftragsabwicklung die Möglichkeit bieten, den bereits eingezogenen Betrag dem Kundenguthaben zu gutschreiben.","anzahl":0},{"id":"REQ-Z-4.6-A3-01","text":"Shop muss fähig sein, den Kunden über die Stornierung mit Grund zu benachrichtigen.","anzahl":0},{"id":"REQ-Z-4.6-A4-01","text":"Shop muss fähig sein, „Bestellung storniert“ (OrderCancelledEvent) zu melden.","anzahl":0},{"id":"REQ-Z-5.2-A2-01","text":"Wenn die Belastung erfolgreich ist, muss Shop die Transaktionsnummer speichern.","anzahl":0},{"id":"REQ-Z-5.2-A2-02","text":"Wenn die Belastung erfolgreich ist, muss Shop „Kreditkarte belastet“ (CreditCardCharged) melden.","anzahl":0},{"id":"REQ-Z-5.3-A1-01","text":"Shop muss fähig sein, die Nachricht „Kreditkarte aktualisiert“ von Kunde entgegenzunehmen.","anzahl":0}],"regeln":[{"id":"R-1","text":"Eine Bestellung hat mindestens eine Bestellposition.","anzahl":0},{"id":"R-2","text":"Die Menge einer Bestellposition ist eine ganze Zahl größer als 0.","anzahl":1},{"id":"R-3","text":"Bestellt der Kunde denselben Artikel mehrmals, werden die Mengen zu einer Bestellposition zusammengefasst.","anzahl":1},{"id":"R-4","text":"Der Bestellwert ist die Summe über alle Bestellpositionen aus Menge mal Preis des Artikels.","anzahl":2},{"id":"R-5","text":"Name und Lieferadresse des Kunden sind Pflicht; ohne sie wird keine Bestellung angenommen.","anzahl":1},{"id":"R-6","text":"Kundenguthaben wird vor der Kreditkarte verrechnet; der Restbetrag ist nie negativ.","anzahl":1},{"id":"R-7","text":"Kommissioniert wird erst nach vollständigem Zahlungseingang.","anzahl":1},{"id":"R-8","text":"Für die Aktualisierung der Kreditkartendaten hat der Kunde 7 Tage Zeit.","anzahl":0},{"id":"R-9","text":"Eine Reservierung läuft nach 7 Tagen ohne Kommissionierung ab.","anzahl":1},{"id":"R-10","text":"Jede